#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

#define BASE 0
#define LOWER 1
#define MAC_BASE 2
#define MAC_LOWER 3
#define WIN_CTRL 4
#define WIN_ALT 5
#define WIN_HOLD 6

/ {
    behaviors {
        win_bspc_del: win_bspc_del {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp BACKSPACE>, <&kp DELETE>;

            mods = <(MOD_LCTL)>;
        };
    };

    macros {
        // macOS Unicode Hex Input: hold Option (LALT) and type the 4-digit hex code.

        mac_uc_succ: mac_uc_succ {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp N2 &kp N2 &kp D &kp F>,
                <&macro_release>,
                <&kp LALT>;
        };

        mac_uc_emdash: mac_uc_emdash {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp N2 &kp N0 &kp N1 &kp N4>,
                <&macro_release>,
                <&kp LALT>;
        };

        // Windows: Ctrl and Alt thumb keys swap their Tab shortcuts. Ctrl + Tab
        // sends Alt+Tab (app switcher, like Cmd+Tab on Mac), Alt + Tab sends
        // Ctrl+Tab (browser tabs). The swapped modifier stays held until the
        // thumb key is released, so tapping Tab again keeps cycling.
        // Releasing a modifier that isn't held is a no-op in ZMK, so the
        // thumb releases don't need to know whether Tab was used.

        win_ctrl: win_ctrl {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&mo WIN_CTRL &kp LCTRL>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mo WIN_HOLD &mo WIN_CTRL &kp LALT &kp LCTRL>;
        };

        // Press Alt before letting go of Ctrl so Windows never sees a lone modifier tap.

        win_ctrl_tab: win_ctrl_tab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_release>,
                <&kp LCTRL>,
                <&macro_press>,
                <&mo WIN_HOLD &kp TAB>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp TAB>;
        };

        win_alt: win_alt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&mo WIN_ALT &kp LALT>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mo WIN_HOLD &mo WIN_ALT &kp LCTRL &kp LALT>;
        };

        // Ctrl goes down before Alt comes up so Windows doesn't see a lone Alt tap (menu bar).

        win_alt_tab: win_alt_tab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_release>,
                <&kp LALT>,
                <&macro_press>,
                <&mo WIN_HOLD &kp TAB>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp TAB>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        window_default {
            label = "default";

            // ------------------------------------------------------------------------------------------------------------
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |       |
            // |  ESC  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | BKSPC |
            // |  TAB  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  |       |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //               | GUI | ALT  | CTRL | LOWER|  ENTER |  | SPACE | RAISE| CTRL  | ALT   | GUI  |

            bindings = <
&kp ESCAPE      &kp N1  &kp N2        &kp N3    &kp N4            &kp N5                                         &kp N6     &kp N7          &kp N8          &kp N9               &kp N0                 &win_bspc_del
&kp TAB         &kp Q   &kp W         &kp E     &kp R             &kp T                                          &kp Y      &kp U           &kp I           &kp O                &kp P                  &kp CAPSLOCK
&mo 1           &kp A   &kp S         &kp D     &kp F             &kp G                                          &kp H      &kp J           &kp K           &kp L                &kp LA(LEFT_CONTROL)   &mo 1
&kp LEFT_SHIFT  &kp Z   &kp X         &kp C     &kp V             &kp B      &bt BT_CLR_ALL        &to MAC_BASE  &kp N      &kp M           &kp UP_ARROW    &kp RA(PRINTSCREEN)  &kp RS(RIGHT_CONTROL)  &kp RIGHT_SHIFT
                        &kp LEFT_WIN  &win_alt  &win_ctrl         &kp SPACE  &kp K_CONTEXT_MENU    &kp ENTER     &kp SPACE  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp BACKSPACE BACKSPACE>;
        };

        window_lower_layer {
            label = "lower";

            // TODO: Some binds are waiting for shifted keycode support.
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  F1 |  F2 |  F3  |  F4  |  F5  |                   |  F6  |  F7   |  F8   |  F9  |  F12  | BKSPC |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |  F12  |
            // |       |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   |   |
            // |       |  =  |  -  |  +   |  {   |  }   |        |  |       |  [   |  ]    |  ;    |  :   |   \   |       |
            //               |RGBTOG|RGBEFF|RGBHUI|RGBHUD|RGBBRI  |ENTER   |  | SPACE | LEFT  | DOWN  |RIGHT |

            bindings = <
&trans                &kp F1           &kp F2           &kp F3           &kp F4           &kp F5                                    &kp F6         &kp F7                &kp F8            &kp F9             &kp F12         &trans
&trans                &kp GRAVE        &kp TILDE        &kp ASTERISK     &kp UNDERSCORE   &kp EQUAL                                 &kp MINUS      &kp PLUS              &kp LBKT          &kp RBKT           &kp LEFT_BRACE  &kp RIGHT_BRACE
&trans                &trans           &kp LA(DOT)      &kp LA(MINUS)    &kp LA(PIPE)     &kp LA(COLON)                             &kp PIPE       &kp NON_US_BACKSLASH  &kp SINGLE_QUOTE  &kp DOUBLE_QUOTES  &kp SEMICOLON   &kp COLON
&kp LS(LEFT_CONTROL)  &ext_power EP_ON  &rgb_ug RGB_EFF  &rgb_ug RGB_HUI  &rgb_ug RGB_HUD  &rgb_ug RGB_BRI  &trans        &trans     &kp LESS_THAN  &kp GREATER_THAN      &kp COMMA         &kp PERIOD         &kp SLASH       &kp QUESTION
                                       &kp HOME         &kp END          &kp PRINTSCREEN  &kp PAUSE_BREAK  &kp INSERT    &kp ENTER  &kp SPACE      &kp LEFT_ARROW        &kp DOWN_ARROW    &kp RIGHT_ARROW
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        mac_default {
            label = "mac";

            // Same as window_default, but CTRL and GUI (Cmd) are swapped so
            // Cmd sits where Ctrl was on Windows.

            bindings = <
&kp ESCAPE      &kp N1  &kp N2            &kp N3    &kp N4        &kp N5                                      &kp N6     &kp N7          &kp N8          &kp N9                 &kp N0                 &kp BACKSPACE
&kp TAB         &kp Q   &kp W             &kp E     &kp R         &kp T                                       &kp Y      &kp U           &kp I           &kp O                  &kp P                  &kp CAPSLOCK
&mo MAC_LOWER   &kp A   &kp S             &kp D     &kp F         &kp G                                       &kp H      &kp J           &kp K           &kp L                  &kp LA(LEFT_CONTROL)   &mo MAC_LOWER
&kp LEFT_SHIFT  &kp Z   &kp X             &kp C     &kp V         &kp B      &bt BT_CLR_ALL        &to BASE   &kp N      &kp M           &kp UP_ARROW    &kp RA(RIGHT_CONTROL)  &kp RS(RIGHT_CONTROL)  &kp RIGHT_SHIFT
                        &kp LEFT_CONTROL  &kp LALT  &kp LEFT_WIN  &kp SPACE  &kp K_CONTEXT_MENU    &kp ENTER  &kp SPACE  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp BACKSPACE BACKSPACE>;
        };

        mac_lower_layer {
            label = "mac lower";

            // Same as window_lower_layer.

            bindings = <
&trans                &kp F1           &kp F2           &kp F3           &kp F4           &kp F5                                    &kp F6         &kp F7                &kp F8            &kp F9             &kp F12         &trans
&trans                &kp GRAVE        &kp TILDE        &kp ASTERISK     &kp UNDERSCORE   &kp EQUAL                                 &kp MINUS      &kp PLUS              &kp LBKT          &kp RBKT           &kp LEFT_BRACE  &kp RIGHT_BRACE
&trans                &trans           &mac_uc_succ     &mac_uc_emdash   &kp LA(PIPE)     &kp LA(COLON)                             &kp PIPE       &kp NON_US_BACKSLASH  &kp SINGLE_QUOTE  &kp DOUBLE_QUOTES  &kp SEMICOLON   &kp COLON
&kp LS(LEFT_CONTROL)  &ext_power EP_ON  &rgb_ug RGB_EFF  &rgb_ug RGB_HUI  &rgb_ug RGB_HUD  &rgb_ug RGB_BRI  &trans        &trans     &kp LESS_THAN  &kp GREATER_THAN      &kp COMMA         &kp PERIOD         &kp SLASH       &kp QUESTION
                                       &kp HOME         &kp END          &kp PRINTSCREEN  &kp PAUSE_BREAK  &kp INSERT    &kp ENTER  &kp SPACE      &kp LEFT_ARROW        &kp DOWN_ARROW    &kp RIGHT_ARROW
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        win_ctrl_layer {
            label = "win ctrl";

            // Active while the Windows Ctrl thumb key is held.

            bindings = <
&trans         &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&win_ctrl_tab  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans         &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans         &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                       &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
            >;
        };

        win_alt_layer {
            label = "win alt";

            // Active while the Windows Alt thumb key is held.

            bindings = <
&trans        &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&win_alt_tab  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans        &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans        &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                      &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
            >;
        };

        win_hold_layer {
            label = "win hold";

            // After the first Tab, later Tabs are plain taps while the swapped modifier stays down.

            bindings = <
&trans   &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&kp TAB  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans   &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans   &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                 &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
