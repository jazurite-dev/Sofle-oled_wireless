#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

#define BASE 0
#define LOWER 1

/ {
    keymap {
        compatible = "zmk,keymap";

        window_default {
            label = "default";

            // ------------------------------------------------------------------------------------------------------------
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |       |
            // |  ESC  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | BKSPC |
            // |  TAB  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  |       |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //               | GUI | ALT  | CTRL | LOWER|  ENTER |  | SPACE | RAISE| CTRL  | ALT   | GUI  |

            bindings = <
&kp ESCAPE      &kp N1  &kp N2        &kp N3    &kp N4            &kp N5                                          &kp N6     &kp N7          &kp N8          &kp N9                 &kp N0                 &kp BACKSPACE
&kp TAB         &kp Q   &kp W         &kp E     &kp R             &kp T                                           &kp Y      &kp U           &kp I           &kp O                  &kp P                  &kp CAPSLOCK
&mo 1           &kp A   &kp S         &kp D     &kp F             &kp G                                           &kp H      &kp J           &kp K           &kp L                  &kp RS(RIGHT_CONTROL)  &mo 1
&kp LEFT_SHIFT  &kp Z   &kp X         &kp C     &kp V             &kp B      &bt BT_CLR_ALL    &ext_power EP_TOG  &kp N      &kp M           &kp UP_ARROW    &kp RA(RIGHT_CONTROL)  &kp K_CONTEXT_MENU     &kp RIGHT_SHIFT
                        &kp LEFT_WIN  &kp LALT  &kp LEFT_CONTROL  &kp SPACE  &kp DELETE        &kp ENTER          &kp SPACE  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp BACKSPACE BACKSPACE>;
        };

        window_lower_layer {
            label = "lower";

            // TODO: Some binds are waiting for shifted keycode support.
            // ------------------------------------------------------------------------------------------------------------
            // |       |  F1 |  F2 |  F3  |  F4  |  F5  |                   |  F6  |  F7   |  F8   |  F9  |  F10  |  F11  |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |  F12  |
            // |       |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   |   |
            // |       |  =  |  -  |  +   |  {   |  }   |        |  |       |  [   |  ]    |  ;    |  :   |   \   |       |
            //               |     |      |      |      |        |  |       |      |       |       |      |

            bindings = <
&kp ESC               &kp F1           &kp F2           &kp F3           &kp F4                &kp F5                                   &kp F6            &kp F7             &kp F8         &kp F9                &kp F10            &kp F11
&kp CAPS              &rgb_ug RGB_HUD  &rgb_ug RGB_EFF  &kp UP_ARROW     &rgb_ug RGB_BRI       &rgb_ug RGB_TOG                          &kp SINGLE_QUOTE  &kp DOUBLE_QUOTES  &kp PIPE       &kp NON_US_BACKSLASH  &kp DOUBLE_QUOTES  &kp F12
&kp TAB               &rgb_ug RGB_HUI  &kp LEFT_ARROW   &kp DOWN_ARROW   &kp GRAVE             &kp TILDE                                &kp CARET         &kp AMPS           &kp LESS_THAN  &kp GREATER_THAN      &kp SEMICOLON      &kp COLON
&kp LS(LEFT_CONTROL)  &kp EQUAL        &kp LEFT_BRACE   &kp RIGHT_BRACE  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans    &trans  &kp LBKT          &kp RBKT           &kp COMMA      &kp PERIOD            &kp SLASH          &kp QUESTION
                                       &trans           &trans           &trans                &trans                 &trans    &trans  &trans            &trans             &trans         &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };
    };
};
