#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

#define BASE 0
#define LOWER 1
#define MAC_BASE 2
#define MAC_LOWER 3

/ {
    macros {
        // macOS Unicode Hex Input: hold Option (LALT) and type the 4-digit hex code.
        mac_uc_succ: mac_uc_succ {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp N2 &kp N2 &kp D &kp F>
                , <&macro_release &kp LALT>
                ;
        };

        mac_uc_emdash: mac_uc_emdash {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp N2 &kp N0 &kp N1 &kp N4>
                , <&macro_release &kp LALT>
                ;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        window_default {
            label = "default";

            // ------------------------------------------------------------------------------------------------------------
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |       |
            // |  ESC  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | BKSPC |
            // |  TAB  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  |       |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //               | GUI | ALT  | CTRL | LOWER|  ENTER |  | SPACE | RAISE| CTRL  | ALT   | GUI  |

            bindings = <
&kp ESCAPE      &kp N1  &kp N2        &kp N3    &kp N4            &kp N5                                              &kp N6     &kp N7          &kp N8          &kp N9                 &kp N0                 &kp BACKSPACE
&kp TAB         &kp Q   &kp W         &kp E     &kp R             &kp T                                               &kp Y      &kp U           &kp I           &kp O                  &kp P                  &kp DEL
&mo 1           &kp A   &kp S         &kp D     &kp F             &kp G                                               &kp H      &kp J           &kp K           &kp L                  &kp CAPSLOCK           &mo 1
&kp LEFT_SHIFT  &kp Z   &kp X         &kp C     &kp V             &kp B      &bt BT_CLR_ALL        &to MAC_BASE       &kp N      &kp M           &kp UP_ARROW    &kp RA(RIGHT_CONTROL)  &kp RS(RIGHT_CONTROL)  &kp RIGHT_SHIFT
                        &kp LEFT_WIN  &kp LALT  &kp LEFT_CONTROL  &kp SPACE  &kp K_CONTEXT_MENU    &kp ENTER          &kp SPACE  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp BACKSPACE BACKSPACE>;
        };

        window_lower_layer {
            label = "lower";

            // TODO: Some binds are waiting for shifted keycode support.
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  F1 |  F2 |  F3  |  F4  |  F5  |                   |  F6  |  F7   |  F8   |  F9  |  F12  | BKSPC |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |  F12  |
            // |       |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   |   |
            // |       |  =  |  -  |  +   |  {   |  }   |        |  |       |  [   |  ]    |  ;    |  :   |   \   |       |
            //               |RGBTOG|RGBEFF|RGBHUI|RGBHUD|RGBBRI  |ENTER   |  | SPACE | LEFT  | DOWN  |RIGHT |

            bindings = <
&trans                &kp F1     &kp F2           &kp F3           &kp F4                &kp F5                                               &kp F6            &kp F7             &kp F8          &kp F9                &kp F12        &trans
&trans                &kp GRAVE  &kp TILDE        &kp ASTERISK     &kp UNDERSCORE        &kp EQUAL                                            &kp MINUS         &kp PLUS           &kp LBKT        &kp RBKT              &kp LEFT_BRACE  &kp RIGHT_BRACE
&trans                &trans     &kp LA(DOT)      &kp LA(MINUS)    &kp LA(PIPE)          &kp LA(COLON)                                        &kp PIPE          &kp NON_US_BACKSLASH  &kp SINGLE_QUOTE  &kp DOUBLE_QUOTES   &kp SEMICOLON  &kp COLON
&kp LS(LEFT_CONTROL)  &rgb_ug RGB_TOG  &rgb_ug RGB_EFF  &rgb_ug RGB_HUI  &rgb_ug RGB_HUD       &rgb_ug RGB_BRI        &trans             &trans     &kp LESS_THAN         &kp GREATER_THAN       &kp COMMA       &kp PERIOD            &kp SLASH      &kp QUESTION
                                 &kp HOME         &kp END          &kp PRINTSCREEN       &kp PAUSE_BREAK        &kp INSERT         &kp ENTER  &kp SPACE         &kp LEFT_ARROW     &kp DOWN_ARROW  &kp RIGHT_ARROW
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        mac_default {
            label = "mac";

            // Same as window_default, but CTRL and GUI (Cmd) are swapped so
            // Cmd sits where Ctrl was on Windows.
            bindings = <
&kp ESCAPE      &kp N1  &kp N2        &kp N3    &kp N4            &kp N5                                              &kp N6     &kp N7          &kp N8          &kp N9                 &kp N0                 &kp BACKSPACE
&kp TAB         &kp Q   &kp W         &kp E     &kp R             &kp T                                               &kp Y      &kp U           &kp I           &kp O                  &kp P                  &kp DEL
&mo MAC_LOWER   &kp A   &kp S         &kp D     &kp F             &kp G                                               &kp H      &kp J           &kp K           &kp L                  &kp CAPSLOCK           &mo MAC_LOWER
&kp LEFT_SHIFT  &kp Z   &kp X         &kp C     &kp V             &kp B      &bt BT_CLR_ALL        &to BASE           &kp N      &kp M           &kp UP_ARROW    &kp RA(RIGHT_CONTROL)  &kp RS(RIGHT_CONTROL)  &kp RIGHT_SHIFT
                        &kp LEFT_CONTROL  &kp LALT  &kp LEFT_WIN  &kp SPACE  &kp K_CONTEXT_MENU    &kp ENTER          &kp SPACE  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp BACKSPACE BACKSPACE>;
        };

        mac_lower_layer {
            label = "mac lower";

            // Same as window_lower_layer.
            bindings = <
&trans                &kp F1     &kp F2           &kp F3           &kp F4                &kp F5                                               &kp F6            &kp F7             &kp F8          &kp F9                &kp F12        &trans
&trans                &kp GRAVE  &kp TILDE        &kp ASTERISK     &kp UNDERSCORE        &kp EQUAL                                            &kp MINUS         &kp PLUS           &kp LBKT        &kp RBKT              &kp LEFT_BRACE  &kp RIGHT_BRACE
&trans                &trans     &mac_uc_succ     &mac_uc_emdash   &kp LA(PIPE)          &kp LA(COLON)                                    &kp PIPE          &kp NON_US_BACKSLASH  &kp SINGLE_QUOTE  &kp DOUBLE_QUOTES   &kp SEMICOLON  &kp COLON
&kp LS(LEFT_CONTROL)  &rgb_ug RGB_TOG  &rgb_ug RGB_EFF  &rgb_ug RGB_HUI  &rgb_ug RGB_HUD       &rgb_ug RGB_BRI        &trans             &trans     &kp LESS_THAN         &kp GREATER_THAN       &kp COMMA       &kp PERIOD            &kp SLASH      &kp QUESTION
                                 &kp HOME         &kp END          &kp PRINTSCREEN       &kp PAUSE_BREAK        &kp INSERT         &kp ENTER  &kp SPACE         &kp LEFT_ARROW     &kp DOWN_ARROW  &kp RIGHT_ARROW
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };
    };
};
